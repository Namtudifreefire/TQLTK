<Window x:Class="PersonalInfoManager.TwoFactorPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.twofactorpromptwindow.text001}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="lblTitle"
                   Text="{DynamicResource xaml.twofactorpromptwindow.text002}"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="lblDescription"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16" />
        <TextBox x:Name="txtCode"
                 Height="44"
                 FontSize="20"
                 MaxLength="12"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="lblError"
                   Foreground="#EF4444"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
        <TextBlock Text="{DynamicResource xaml.twofactorpromptwindow.text003}"
                   FontSize="11"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{DynamicResource xaml.twofactorpromptwindow.text004}"
                    Height="38" Padding="20,8" Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{StaticResource OutlineButton}" />
            <Button x:Name="btnOk"
                    Content="{DynamicResource xaml.twofactorpromptwindow.text005}"
                    Height="38" Padding="20,8"
                    IsDefault="True"
                    Click="BtnOk_Click" />
        </StackPanel>
    </StackPanel>
</Window>
