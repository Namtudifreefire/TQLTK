<Window x:Class="PersonalInfoManager.AccountHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.accounthistorywindow.text001}" Height="500" Width="760" MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.accounthistorywindow.text002}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource xaml.accounthistorywindow.text003}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DataGrid x:Name="dgHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource xaml.accounthistorywindow.text004}" Binding="{Binding ChangedAtText}" Width="170" />
                <DataGridTextColumn Header="{DynamicResource xaml.accounthistorywindow.text005}" Binding="{Binding ChangedFieldsText}" Width="*" />
                <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource xaml.accounthistorywindow.text006}" Tag="{Binding Id}" Click="BtnPreview_Click" Style="{StaticResource RowButton}" Padding="8,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource xaml.accounthistorywindow.text007}" Click="BtnClose_Click" Style="{StaticResource OutlineButton}" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
