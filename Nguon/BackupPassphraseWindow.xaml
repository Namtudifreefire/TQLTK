<Window x:Class="PersonalInfoManager.BackupPassphraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.backuppassphrasewindow.text001}"
        Width="500" MinWidth="320" MinHeight="240" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock x:Name="txtTitle"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="txtDesc"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" TextWrapping="Wrap"
                   Margin="0,10,0,16" />
        <TextBlock Text="{DynamicResource xaml.backuppassphrasewindow.text002}" FontWeight="SemiBold" Margin="0,0,0,5" />
        <PasswordBox x:Name="pwdMain" Height="38"
                     Style="{StaticResource RoundedPasswordBox}" />
        <StackPanel x:Name="panelConfirm" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource xaml.backuppassphrasewindow.text003}" FontWeight="SemiBold" Margin="0,0,0,5" />
            <PasswordBox x:Name="pwdConfirm" Height="38"
                         Style="{StaticResource RoundedPasswordBox}" />
        </StackPanel>
        <TextBlock x:Name="txtHint" Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="{DynamicResource xaml.backuppassphrasewindow.text004}" />
        <TextBlock x:Name="txtError" Visibility="Collapsed"
                   Foreground="#EF4444"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
    </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource xaml.backuppassphrasewindow.text005}" MinWidth="90"
                    Style="{StaticResource OutlineButton}"
                    IsCancel="True" />
            <Button x:Name="btnOk" Content="{DynamicResource xaml.backuppassphrasewindow.text006}" MinWidth="100"
                    Style="{StaticResource RoundedButton}"
                    IsDefault="True"
                    Click="BtnOk_Click" />
        </WrapPanel>
    </Grid>
</Window>
