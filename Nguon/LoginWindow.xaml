<Window x:Class="PersonalInfoManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.loginwindow.text001}"
        Height="680" Width="520"
        MinHeight="620" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="35,20,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource xaml.loginwindow.text002}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource xaml.loginwindow.text003}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource xaml.loginwindow.text004}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44" FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtUsername_KeyDown" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.loginwindow.text005}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword"
                             Height="44" FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtPassword_KeyDown" />
            </StackPanel>
            <Button Grid.Row="4"
                    Height="50"
                    Margin="0,25,0,0"
                    IsDefault="True"
                    Click="BtnLogin_Click">
                <TextBlock Text="{DynamicResource xaml.loginwindow.text006}"
                           FontSize="15" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </Button>
            <Button Grid.Row="5"
                    Height="50"
                    Margin="0,10,0,0"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnWindowsHello_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource xaml.loginwindow.text007}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Row="6"
                    Height="46"
                    Margin="0,10,0,0"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnRegister_Click">
                <TextBlock Text="{DynamicResource xaml.loginwindow.text008}"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Button>
            <TextBlock Grid.Row="7"
                       x:Name="lblStatus"
                       Foreground="#EF4444"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />
            <Border Grid.Row="8"
                    Margin="0,20,0,0"
                    Padding="16,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="txtCopyright"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="1,0"
                               HorizontalAlignment="Stretch" />
                    <TextBlock Text="{DynamicResource xaml.loginwindow.text009}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource xaml.loginwindow.text010}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="cmbLanguageLogin" Width="120" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource xaml.loginwindow.text011}" Tag="vi" />
                    <ComboBoxItem Content="{DynamicResource xaml.loginwindow.text012}" Tag="en" />
                </ComboBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
