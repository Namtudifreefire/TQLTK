<Window x:Class="PersonalInfoManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - TQLTK"
        Height="680" Width="520"
        MinHeight="620" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="35,20,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0"
                       Text="🔐 Đăng nhập"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1"
                       Text="TQLTK - Trình Quản Lý Tài Khoản"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />

            <!-- Username -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Tên đăng nhập:"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44" FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center"
                         KeyDown="TxtUsername_KeyDown" />
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="Mật khẩu:"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword"
                             Height="44" FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             KeyDown="TxtPassword_KeyDown" />
            </StackPanel>

            <!-- Nút Đăng nhập -->
            <Button Grid.Row="4"
                    Height="50"
                    Margin="0,25,0,0"
                    IsDefault="True"
                    Click="BtnLogin_Click">
                <TextBlock Text="🔓  Đăng nhập"
                           FontSize="15" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </Button>

            <!-- ✅ Nút Windows Hello -->
            <Button Grid.Row="5"
                    Height="50"
                    Margin="0,10,0,0"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnWindowsHello_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" FontSize="16"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Đăng nhập bằng Windows Hello"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Nút Đăng ký -->
            <Button Grid.Row="6"
                    Height="46"
                    Margin="0,10,0,0"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnRegister_Click">
                <TextBlock Text="📝  Chưa có tài khoản? Đăng ký ngay"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Button>

            <!-- Trạng thái -->
            <TextBlock Grid.Row="7"
                       x:Name="lblStatus"
                       Foreground="#EF4444"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />

            <!-- Gợi ý -->
            <Border Grid.Row="8"
                    Margin="0,20,0,0"
                    Padding="16,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Made By 天地と月の造化 - TQLTK v3.6.3 (BETA) | © 2026 All Rights Reserved"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="🔐 Bật Windows Hello trong Thông tin cá nhân"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontStyle="Italic"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>