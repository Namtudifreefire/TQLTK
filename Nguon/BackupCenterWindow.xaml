<Window x:Class="PersonalInfoManager.BackupCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.backupcenterwindow.text001}" Height="620" Width="900"
        MinHeight="440" MinWidth="620" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.backupcenterwindow.text002}" FontSize="21" FontWeight="Bold" />
            <TextBlock x:Name="txtStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DataGrid x:Name="dgBackups" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                  SelectionChanged="DgBackups_SelectionChanged" HeadersVisibility="Column"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource xaml.backupcenterwindow.text003}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{DynamicResource xaml.backupcenterwindow.text004}" Binding="{Binding DateText}" Width="170" />
                <DataGridTextColumn Header="{DynamicResource xaml.backupcenterwindow.text005}" Binding="{Binding SizeText}" Width="120" />
                <DataGridTextColumn Header="{DynamicResource xaml.backupcenterwindow.text006}" Binding="{Binding PinText, Converter={StaticResource LocalizedTextConverter}}" Width="125" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="txtSelection" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="btnRefresh" Content="{DynamicResource xaml.backupcenterwindow.text007}" Click="BtnRefresh_Click"
                    Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,8" />
            <Button x:Name="btnOpenFolder" Content="{DynamicResource xaml.backupcenterwindow.text008}" Click="BtnOpenFolder_Click"
                    Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,8" />
            <Button x:Name="btnPin" Content="{DynamicResource xaml.backupcenterwindow.text009}" Click="BtnPin_Click"
                    Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,8" IsEnabled="False" />
            <Button x:Name="btnVerify" Content="{DynamicResource xaml.backupcenterwindow.text010}" Click="BtnVerify_Click"
                    Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,8" IsEnabled="False" />
            <Button x:Name="btnCompare" Content="{DynamicResource xaml.backupcenterwindow.text011}" Click="BtnCompare_Click"
                    Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,8" IsEnabled="False" />
            <Button x:Name="btnRestore" Click="BtnRestore_Click"
                    Style="{StaticResource RoundedButton}" Padding="14,8" Margin="0,0,0,8" IsEnabled="False">
                <TextBlock Text="{DynamicResource xaml.backupcenterwindow.text012}" Foreground="White" TextWrapping="Wrap" />
            </Button>
        </WrapPanel>
    </Grid>
</Window>
