<Window x:Class="PersonalInfoManager.BackupComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="So sánh bản sao lưu" Height="640" Width="1020" MinHeight="440" MinWidth="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtSummary" Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <DataGrid x:Name="dgChanges" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                  RowHeight="NaN"
                  CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="MinHeight" Value="48" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mục" Binding="{Binding Name}" Width="2*" MinWidth="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Thay đổi" Binding="{Binding Status, Converter={StaticResource LocalizedTextConverter}}" Width="140" IsReadOnly="True" />
                <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details, Converter={StaticResource LocalizedTextConverter}}" Width="2*" MinWidth="180" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Khôi phục từ" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableSources}"
                                      SelectedItem="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="32" Padding="5,2">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource LocalizedTextConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnRecover"
                    Click="BtnRecover_Click" Style="{StaticResource RoundedButton}"
                    Padding="16,8" Margin="0,0,8,8">
                <TextBlock Text="Khôi phục mục đã chọn thành bản sao" Foreground="White" TextWrapping="Wrap" />
            </Button>
            <Button Content="Đóng" Click="BtnClose_Click"
                    Style="{StaticResource OutlineButton}" Padding="18,8" Margin="0,0,0,8" IsCancel="True" />
        </WrapPanel>
    </Grid>
</Window>
