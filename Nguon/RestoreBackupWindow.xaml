<Window x:Class="PersonalInfoManager.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.restorebackupwindow.text001}"
        Height="500" Width="680"
        MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource RoundedButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="{DynamicResource xaml.restorebackupwindow.text002}"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock x:Name="txtStatus" Grid.Row="1"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0">
            <DataGrid x:Name="dgBackups"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      BorderThickness="0"
                      SelectionChanged="DgBackups_SelectionChanged"
                      MouseDoubleClick="DgBackups_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource xaml.restorebackupwindow.text003}"
                                        Binding="{Binding CreatedText, Mode=OneWay}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource xaml.restorebackupwindow.text004}"
                                        Binding="{Binding SizeText, Mode=OneWay}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource xaml.restorebackupwindow.text005}"
                                        Binding="{Binding OwnerText, Mode=OneWay, Converter={StaticResource LocalizedTextConverter}}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="{DynamicResource xaml.restorebackupwindow.text006}"
                                        Binding="{Binding Name, Mode=OneWay}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <CheckBox x:Name="chkOthers" Grid.Row="3" Margin="0,12,0,0"
                  Content="{DynamicResource xaml.restorebackupwindow.text007}"
                  Checked="ChkOthers_Changed" Unchecked="ChkOthers_Changed" />
        <TextBlock x:Name="txtNote" Grid.Row="4"
                   Text="{DynamicResource xaml.restorebackupwindow.text008}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource xaml.restorebackupwindow.text009}" MinWidth="90"
                    Style="{StaticResource OutlineButton}"
                    IsCancel="True" />
            <Button x:Name="btnRestore" Content="{DynamicResource xaml.restorebackupwindow.text010}" MinWidth="130"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" IsEnabled="False"
                    Click="BtnRestore_Click" />
        </StackPanel>
    </Grid>
</Window>
