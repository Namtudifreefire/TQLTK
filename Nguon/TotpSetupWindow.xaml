<Window x:Class="PersonalInfoManager.TotpSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.totpsetupwindow.text001}" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.totpsetupwindow.text002}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource xaml.totpsetupwindow.text003}"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="txtSource" MinHeight="74" MaxHeight="120" Padding="9"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 ToolTip="{DynamicResource xaml.totpsetupwindow.text004}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,12">
            <Button Content="{DynamicResource xaml.totpsetupwindow.text005}" Click="BtnReadImage_Click" Padding="14,7" />
            <Button Content="{DynamicResource xaml.totpsetupwindow.text006}" Click="BtnImportFile_Click" Padding="14,7" Margin="8,0,0,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="{DynamicResource xaml.totpsetupwindow.text007}" Click="BtnParse_Click" Padding="14,7" Margin="8,0,0,0"
                    Style="{StaticResource OutlineButton}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.totpsetupwindow.text008}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <ComboBox x:Name="cmbEntries" DisplayMemberPath="Name" SelectionChanged="Entries_SelectionChanged" />
            <TextBlock x:Name="lblDetails" Text="{DynamicResource xaml.totpsetupwindow.text009}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
            <TextBlock x:Name="lblError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="{DynamicResource xaml.totpsetupwindow.text010}"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource xaml.totpsetupwindow.text011}" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" />
            <Button Content="{DynamicResource xaml.totpsetupwindow.text012}" Click="BtnSave_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
