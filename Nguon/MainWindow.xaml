<Window x:Class="PersonalInfoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TQLTK Made By thienthuongthienha_duyngadocton_"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

	<DockPanel>

		<!-- ================== MENU ================== -->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Hệ thống">
				<MenuItem x:Name="mnuAdmin"
                          Header="Quản lý tài khoản"
                          Click="MnuAdmin_Click" />
				<Separator />
				<MenuItem Header="Đổi mật khẩu" Click="MnuChangePwd_Click" />
				<MenuItem Header="Đăng xuất" Click="MnuLogout_Click" />
				<Separator />
				<MenuItem Header="Thoát" Click="MnuExit_Click" />
			</MenuItem>

			<MenuItem Header="Tiện ích">
				<MenuItem Header="Thông tin hệ thống" Click="MnuSysInfo_Click" />
				<Separator />

				<MenuItem Header="🌗 Đổi Sáng / Tối" Click="MnuToggleTheme_Click" />
				<MenuItem x:Name="mnuAutoTheme"
                          Header="⏰ Tự động đổi theme theo giờ"
                          IsCheckable="True"
                          Click="MnuAutoTheme_Click" />

				<Separator />

				<MenuItem Header="💾 Xuất vault (Backup)" Click="MnuExportVault_Click" />
				<MenuItem Header="📥 Nhập vault (Restore)" Click="MnuImportVault_Click" />

				<!-- ✅ CSV MENU -->
				<MenuItem Header="📤 Xuất CSV" Click="MnuExportCsv_Click" />
				<MenuItem Header="📥 Nhập CSV" Click="MnuImportCsv_Click" />

				<Separator />

				<MenuItem Header="☁️ Đồng bộ Google Drive (BETA)"
                          Click="MnuSyncGoogleDrive_Click" />
				<MenuItem Header="☁️ Khôi phục từ Google Drive (BETA)"
                          Click="MnuRestoreGoogleDrive_Click" />
				<MenuItem Header="📁 Sao lưu File cá nhân lên Drive (BETA)"
                          Click="MnuSyncFilesGoogleDrive_Click" />
				<MenuItem Header="📁 Khôi phục File cá nhân từ Drive (BETA)"
                          Click="MnuRestoreFilesGoogleDrive_Click" />
				<MenuItem Header="🔑 Cụm mật khẩu sao lưu"
                          Click="MnuBackupPassphrase_Click" />

				<Separator />

				<!-- ✅ XÁC THỰC 2 BƯỚC (AUTHENTICATOR) -->
				<MenuItem x:Name="mnu2FA"
                          Header="🔑 Bật xác thực 2 bước (Authenticator)"
                          Click="Mnu2FA_Click" />

				<Separator />

				<MenuItem Header="📍 Đưa cửa sổ về giữa" Click="MnuCenterWindow_Click" />

				<Separator />

				<MenuItem Header="🔧 Reset cài đặt" Click="MnuResetSettings_Click" />
			</MenuItem>
		</Menu>

		<!-- ================== STATUS BAR ================== -->
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock x:Name="lblUser" />
			</StatusBarItem>
			<StatusBarItem>
				<TextBlock x:Name="lblTheme"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<TextBlock x:Name="lblStorage" />
			</StatusBarItem>
		</StatusBar>

		<!-- ================== TAB CONTROL ================== -->
		<TabControl Style="{StaticResource ModernTabControl}"
                    Margin="10,10,10,5"
                    Background="Transparent">

			<!-- ============ TAB 1: TÀI KHOẢN ĐÃ LƯU ============ -->
			<TabItem Header="🔐 Tài khoản đã lưu">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" Orientation="Horizontal">
								<TextBlock Text="🔍 Tìm:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
								<TextBox x:Name="txtSearch"
                                         Width="250"
                                         Height="34"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged" />
								<TextBlock Text="(theo tên dịch vụ, username, ghi chú)"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
							</StackPanel>

							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button Height="34" Padding="15,6" Click="BtnAddAccount_Click">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="➕" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
										<TextBlock Text="Thêm mới" VerticalAlignment="Center" />
									</StackPanel>
								</Button>

								<Button Height="34" Padding="15,6"
                                        Click="BtnRefreshAccounts_Click"
                                        Style="{StaticResource OutlineButton}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="↻" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
										<TextBlock Text="Refresh" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>
					</Border>

					<Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
						<!-- Cột dùng độ rộng CỐ ĐỊNH / sao (*) thay vì Auto: Auto buộc WPF đo nội dung từng ô
                             mỗi lần đổi danh sách (chậm khi lọc). Recycling tái sử dụng dòng đã dựng. -->
						<DataGrid x:Name="dgAccounts"
                                  Style="{StaticResource FadeInDataGrid}"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="DgAccounts_SelectionChanged">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Dịch vụ" Binding="{Binding ServiceName}" Width="220" />
								<DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="240" />
								<DataGridTextColumn Header="Password" Binding="{Binding PasswordMasked}" Width="180" />
								<DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*" MinWidth="200" />
								<DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150" />
							</DataGrid.Columns>
						</DataGrid>
					</Border>

					<Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,10,0,0">
						<WrapPanel Orientation="Horizontal">
							<Button Height="40" Margin="3" Padding="15,8" Click="BtnToggleShow_Click">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="👁" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="Hiện / Ẩn MK" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Height="40" Margin="3" Padding="15,8" Click="BtnCopyUsername_Click" Style="{StaticResource OutlineButton}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="Copy Username" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Height="40" Margin="3" Padding="15,8" Click="BtnCopyPassword_Click" Style="{StaticResource OutlineButton}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="Copy Password" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Height="40" Margin="3" Padding="15,8" Click="BtnEditAccount_Click" Style="{StaticResource OutlineButton}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="✏" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="Sửa" VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Height="40" Margin="3" Padding="15,8" Background="#EF4444" Foreground="White" BorderThickness="0" Click="BtnDeleteAccount_Click">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
									<TextBlock Text="Xóa" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</WrapPanel>
					</Border>
				</Grid>
			</TabItem>

			<!-- ============ TAB 2: FILE CÁ NHÂN ============ -->
			<TabItem Header="📁 File cá nhân">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<WrapPanel Orientation="Horizontal">
						<Button Height="38" Padding="15,8" Click="BtnImport_Click">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
								<TextBlock Text="Import" VerticalAlignment="Center" />
							</StackPanel>
						</Button>

						<Button Height="38" Padding="15,8" Click="BtnExport_Click" Style="{StaticResource OutlineButton}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
								<TextBlock Text="Export" VerticalAlignment="Center" />
							</StackPanel>
						</Button>

						<Button Height="38" Padding="15,8" Click="BtnCreateText_Click" Style="{StaticResource OutlineButton}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="📝" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
								<TextBlock Text="Tạo text" VerticalAlignment="Center" />
							</StackPanel>
						</Button>

						<Button Height="38" Padding="15,8" Background="#EF4444" Foreground="White" BorderThickness="0" Click="BtnDeleteFile_Click">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
								<TextBlock Text="Xóa" VerticalAlignment="Center" />
							</StackPanel>
						</Button>

						<Button Height="38" Padding="15,8" Click="BtnRefreshFiles_Click" Style="{StaticResource OutlineButton}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="↻" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
								<TextBlock Text="Refresh" VerticalAlignment="Center" />
							</StackPanel>
						</Button>
					</WrapPanel>

					<Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,10,0,0">
						<DataGrid x:Name="dgFiles"
                                  Style="{StaticResource FadeInDataGrid}"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Tên file" Binding="{Binding Name}" Width="Auto" MinWidth="250" />
								<DataGridTextColumn Header="Kích thước" Binding="{Binding Length}" Width="Auto" MinWidth="150" />
								<DataGridTextColumn Header="Ngày sửa" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="Auto" MinWidth="200" />
								<DataGridTextColumn Header="Đường dẫn" Binding="{Binding FullName}" Width="Auto" MinWidth="400" />
							</DataGrid.Columns>
						</DataGrid>
					</Border>
				</Grid>
			</TabItem>

			<!-- ============ TAB 3: THÔNG TIN CÁ NHÂN ============ -->
			<TabItem Header="👤 Thông tin cá nhân">
				<ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
					<Grid Margin="30">
						<Border Style="{StaticResource Card}" Padding="25" MaxWidth="750" HorizontalAlignment="Left">
							<StackPanel>
								<TextBlock Text="👤 Thông tin cá nhân"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,25" />

								<TextBlock Text="Tên đăng nhập (không đổi):" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBox x:Name="txtProfileUsername" Height="38" IsReadOnly="True" VerticalContentAlignment="Center" Background="{DynamicResource BackgroundBrush}" Margin="0,0,0,15" />

								<TextBlock Text="Họ tên:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBox x:Name="txtProfileFullName" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,15" />

								<TextBlock Text="Gmail:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBox x:Name="txtProfileEmail" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,15" />

								<TextBlock Text="Số điện thoại:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBox x:Name="txtProfilePhone" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,15" />

								<TextBlock Text="Vai trò:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBlock x:Name="lblProfileRole" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15" />

								<TextBlock Text="Ngày tạo tài khoản:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
								<TextBlock x:Name="lblProfileCreatedAt" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />

								<!-- ============ WINDOWS HELLO ============ -->
								<Border Margin="0,10,0,0"
                                        Padding="15"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
									<StackPanel>
										<TextBlock Text="🔐 Đăng nhập bằng Windows Hello (BETA)"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,6" />

										<TextBlock Text="Cho phép đăng nhập TQLTK bằng vân tay / khuôn mặt / PIN của Windows."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,10" />

										<!-- ✅ Nút Windows Hello -->
										<Button x:Name="btnToggleWindowsHello"
                                                Height="40" HorizontalAlignment="Left"
                                                Click="BtnToggleWindowsHello_Click"
                                                Style="{StaticResource OutlineButton}">
											<StackPanel Orientation="Horizontal">
												<TextBlock Text="🔐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
												<TextBlock x:Name="lblWindowsHelloBtnText" Text="Bật Windows Hello" VerticalAlignment="Center"/>
											</StackPanel>
										</Button>

										<TextBlock x:Name="lblWindowsHelloStatus"
                                                   FontSize="11" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
									</StackPanel>
								</Border>

								<!-- ============ LƯU ============ -->
								<Button Height="42" Padding="20,10"
                                        HorizontalAlignment="Left"
                                        Margin="0,20,0,0"
                                        Click="BtnSaveProfile_Click">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
										<TextBlock Text="Lưu thay đổi" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
