<Window x:Class="PersonalInfoManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.mainwindow.text001}"
        Height="700" Width="1100"
        MinHeight="420" MinWidth="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}"
        PreviewMouseDown="MainWindow_PreviewMouseDown">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TabSelectedForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,14,0,6" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UserChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UserMenuItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,14" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RowState" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecurityFindingListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowDangerButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="BorderBrush" Value="#EF4444" />
        </Style>
        <Style x:Key="AccountGridText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
        <Style x:Key="AccountGridPasswordText" TargetType="TextBlock" BasedOn="{StaticResource AccountGridText}">
            <Setter Property="ToolTip" Value="{x:Null}" />
        </Style>
        <Style x:Key="AccountGridCenteredText" TargetType="TextBlock" BasedOn="{StaticResource AccountGridText}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AccountGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}">
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style x:Key="AccountActionPopupButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionItemBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountActionPopupDangerButton" TargetType="Button" BasedOn="{StaticResource AccountActionPopupButton}">
            <Setter Property="Foreground" Value="#EF4444" />
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel x:Name="shellMain">
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock x:Name="lblTheme"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="lblStorage" />
                </StatusBarItem>
            </StatusBar>
            <Border DockPanel.Dock="Top" Padding="12,8,16,2">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnToggleSidebar"
                            Style="{StaticResource IconButton}"
                            Content="&#xE700;"
                            ToolTip="{DynamicResource xaml.mainwindow.text002}"
                            Click="BtnToggleSidebar_Click" />
                    <TextBlock Text="🔐" FontSize="22" Margin="12,0,8,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TQLTK" FontSize="16" FontWeight="Bold" Margin="0" />
                        <TextBlock Text="{DynamicResource xaml.mainwindow.text003}" Style="{StaticResource RowDesc}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="panelSidebar" Grid.Column="0" Width="250" ClipToBounds="True">
                    <DockPanel Width="226" HorizontalAlignment="Left" Margin="14,6,10,10">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="btnUser"
                                    Style="{StaticResource UserChip}"
                                    ToolTip="{DynamicResource xaml.mainwindow.text004}"
                                    Click="BtnUser_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock x:Name="lblAvatar"
                                                   Text="?"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Margin="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                                        <TextBlock x:Name="lblUserName"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0" />
                                        <TextBlock x:Name="lblUserRole"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Popup x:Name="popUserMenu"
                                   PlacementTarget="{Binding ElementName=btnUser}"
                                   Placement="Top"
                                   HorizontalOffset="-12"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Closed="PopUserMenu_Closed">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        Margin="12"
                                        MinWidth="226">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="12" ShadowDepth="2" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="lblMenuEmail"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="10,6,10,6" />
                                        <Button Style="{StaticResource UserMenuItem}" Tag="settings" Click="UserMenu_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{DynamicResource xaml.mainwindow.text005}" FontSize="14" Margin="0" />
                                                <TextBlock Grid.Column="1" Text="{DynamicResource xaml.mainwindow.text006}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Separator />
                                        <Button Style="{StaticResource UserMenuItem}" Tag="logout" Click="UserMenu_Click">
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text007}" FontSize="14" Margin="0" />
                                        </Button>
                                        <Button Style="{StaticResource UserMenuItem}" Tag="exit" Click="UserMenu_Click">
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text008}" FontSize="14" Margin="0" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,10,0,0">
                                <RadioButton x:Name="navAccounts" GroupName="Nav" Tag="accounts" Content="{DynamicResource xaml.mainwindow.text009}"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked" />
                                <RadioButton GroupName="Nav" Tag="files" Content="{DynamicResource xaml.mainwindow.text010}"
                                             Style="{StaticResource NavItem}" Checked="Nav_Checked" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid x:Name="pageAccounts" Margin="24,20" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource xaml.mainwindow.text011}" Style="{StaticResource PageTitle}" />
                            <Border Grid.Row="1"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,8,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource xaml.mainwindow.text012}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBox x:Name="txtSearch"
                                                 Width="220"
                                                 Height="34"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TxtSearch_TextChanged" />
                                        <CheckBox x:Name="chkFavoritesOnly" Content="{DynamicResource xaml.mainwindow.text013}"
                                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                                  Checked="AccountFilters_Changed" Unchecked="AccountFilters_Changed"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource xaml.mainwindow.text014}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <Button Height="34" Padding="15,6" Click="BtnAddAccount_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="➕" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource xaml.mainwindow.text015}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="34" Padding="15,6"
                                                Click="BtnRefreshAccounts_Click"
                                                Style="{StaticResource OutlineButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↻" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource xaml.mainwindow.text016}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="34" Padding="15,6" Click="BtnOpenTrash_Click"
                                                Style="{StaticResource OutlineButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource xaml.mainwindow.text017}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,9,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text018}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="cmbDomainFilter" Width="168" Height="40" Padding="10,4"
                                                      VerticalContentAlignment="Center" SelectionChanged="AccountFilters_Changed">
                                                <ComboBoxItem Content="{DynamicResource xaml.mainwindow.text019}" Tag="" IsSelected="True" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text020}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="cmbFolderFilter" Width="158" Height="40" Padding="10,4"
                                                      VerticalContentAlignment="Center" SelectionChanged="AccountFilters_Changed">
                                                <ComboBoxItem Content="{DynamicResource xaml.mainwindow.text021}" Tag="" IsSelected="True" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text022}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ComboBox x:Name="cmbTagFilter" Width="145" Height="40" Padding="10,4"
                                                      VerticalContentAlignment="Center" SelectionChanged="AccountFilters_Changed">
                                                <ComboBoxItem Content="{DynamicResource xaml.mainwindow.text023}" Tag="" IsSelected="True" />
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="chkMissingTotpOnly" Content="{DynamicResource xaml.mainwindow.text024}" VerticalAlignment="Center"
                                                  Margin="0,0,12,6" Checked="AccountFilters_Changed" Unchecked="AccountFilters_Changed"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <CheckBox x:Name="chkSecurityWarningOnly" Content="{DynamicResource xaml.mainwindow.text025}" VerticalAlignment="Center"
                                                  Margin="0,0,12,6" Checked="AccountFilters_Changed" Unchecked="AccountFilters_Changed"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <DataGrid x:Name="dgAccounts"
                                          Style="{StaticResource FadeInDataGrid}"
                                          CellStyle="{StaticResource AccountGridCell}"
                                          CanUserResizeColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectionChanged="DgAccounts_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="★" Binding="{Binding FavoriteText}" Width="42"
                                                            ElementStyle="{StaticResource AccountGridCenteredText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text026}" Binding="{Binding ServiceName}" Width="230"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text027}" Binding="{Binding Username}" Width="280"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text028}" Binding="{Binding PasswordMasked}" Width="140"
                                                            ElementStyle="{StaticResource AccountGridPasswordText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text029}" Binding="{Binding WebsiteDisplay}" Width="240"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text030}" Binding="{Binding FolderAndTagsText}" Width="230"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text031}" Binding="{Binding Note}" Width="300"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text032}" Binding="{Binding PasswordChangedText, Converter={StaticResource LocalizedTextConverter}}" Width="180"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                        <DataGridTextColumn Header="TOTP" Binding="{Binding TotpState, Converter={StaticResource LocalizedTextConverter}}" Width="90"
                                                            ElementStyle="{StaticResource AccountGridCenteredText}" />
                                        <DataGridTextColumn Header="{DynamicResource xaml.mainwindow.text033}" Binding="{Binding UpdatedAt, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=DateTime}" Width="185"
                                                            ElementStyle="{StaticResource AccountGridText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Row="3"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Height="38" Margin="3" Padding="12,6" Click="BtnToggleShow_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👁" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource xaml.mainwindow.text034}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
