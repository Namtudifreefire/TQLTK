<Window x:Class="PersonalInfoManager.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thùng rác" Width="760" Height="480" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Thùng rác" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Tài khoản và ghi chú giữ lại 30 ngày. Xóa hẳn cần xác thực lại." TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="dgTrash" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Loại" Binding="{Binding TypeLabel}" Width="110" />
                <DataGridTextColumn Header="Tên" Binding="{Binding Title}" Width="190" />
                <DataGridTextColumn Header="Thông tin" Binding="{Binding Detail}" Width="*" />
                <DataGridTextColumn Header="Đã xóa" Binding="{Binding DeletedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="145" />
                <DataGridTextColumn Header="Còn lại" Binding="{Binding DaysRemaining, StringFormat={}{0} ngày}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="lblEmpty" Text="Thùng rác đang trống." VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Khôi phục" Click="BtnRestore_Click" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="Xóa hẳn" Click="BtnDeleteForever_Click" Padding="16,8"
                        Background="#EF4444" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
