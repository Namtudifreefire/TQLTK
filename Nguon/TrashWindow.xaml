<Window x:Class="PersonalInfoManager.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.trashwindow.text001}" Width="760" Height="480" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.trashwindow.text001}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource xaml.trashwindow.text002}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="dgTrash" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource xaml.trashwindow.text003}" Binding="{Binding TypeLabel, Converter={StaticResource LocalizedTextConverter}}" Width="110" />
                <DataGridTextColumn Header="{DynamicResource xaml.trashwindow.text004}" Binding="{Binding Title}" Width="190" />
                <DataGridTextColumn Header="{DynamicResource xaml.trashwindow.text005}" Binding="{Binding Detail}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource xaml.trashwindow.text006}" Binding="{Binding DeletedAt, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=DateTime}" Width="145" />
                <DataGridTextColumn Header="{DynamicResource xaml.trashwindow.text007}" Binding="{Binding DaysRemaining, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=DaysRemaining}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="lblEmpty" Text="{DynamicResource xaml.trashwindow.text008}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource xaml.trashwindow.text009}" Click="BtnRestore_Click" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="{DynamicResource xaml.trashwindow.text010}" Click="BtnDeleteForever_Click" Padding="16,8"
                        Background="#EF4444" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
