<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PersonalInfoManager.SecurityRegression</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PersonalInfoManager.csproj" AdditionalProperties="SecurityRegressionBuild=true;Configuration=SecurityRegression" />
  </ItemGroup>
</Project>
