<Window x:Class="PersonalInfoManager.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.registerwindow.text001}"
        Height="700" Width="520"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="lblFormTitle"
                       Grid.Row="0"
                       Text="{DynamicResource xaml.registerwindow.text002}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="lblFormDescription"
                       Grid.Row="1"
                       Text="{DynamicResource xaml.registerwindow.text003}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text004}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="{DynamicResource xaml.registerwindow.text005}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text006}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtPassword_PasswordChanged" />
                <TextBlock x:Name="lblStrength"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text007}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtConfirm"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtConfirm_PasswordChanged" />
                <TextBlock x:Name="lblConfirmStatus"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text008}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtFullName"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text009}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtEmail"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="{DynamicResource xaml.registerwindow.text010}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="7" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.registerwindow.text011}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtPhone"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="8" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="{DynamicResource xaml.registerwindow.text012}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        Click="BtnRegister_Click">
                    <TextBlock x:Name="lblRegisterButton"
                               Text="{DynamicResource xaml.registerwindow.text013}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="9"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center">
                Đã có tài khoản? Đóng cửa sổ này để quay lại đăng nhập.
            </TextBlock>
        </Grid>
    </ScrollViewer>
</Window>
