<Window x:Class="PersonalInfoManager.AccountAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.accountattachmentswindow.text001}" Height="560" Width="760" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.accountattachmentswindow.text002}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource xaml.accountattachmentswindow.text003}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="{DynamicResource xaml.accountattachmentswindow.text004}" Click="BtnAdd_Click" Style="{StaticResource OutlineButton}" Padding="14,7" />
            <Button DockPanel.Dock="Left" Content="{DynamicResource xaml.accountattachmentswindow.text005}" Click="BtnRemove_Click" Style="{StaticResource OutlineButton}" Padding="14,7" Margin="8,0,0,0" />
            <TextBlock x:Name="lblSize" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
        <DataGrid x:Name="dgAttachments" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource xaml.accountattachmentswindow.text006}" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="{DynamicResource xaml.accountattachmentswindow.text007}" Binding="{Binding SizeText}" Width="120" />
                <DataGridTextColumn Header="{DynamicResource xaml.accountattachmentswindow.text008}" Binding="{Binding AddedAtText}" Width="170" />
                <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource xaml.accountattachmentswindow.text009}" Tag="{Binding Id}" Click="BtnExport_Click" Style="{StaticResource RowButton}" Padding="8,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource xaml.accountattachmentswindow.text010}" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="{DynamicResource xaml.accountattachmentswindow.text011}" Click="BtnSave_Click" IsDefault="True" Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
