<Window x:Class="PersonalInfoManager.AccountAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tệp đính kèm" Height="560" Width="760" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Tệp đính kèm được mã hóa cùng vault" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Tối đa 10 MB mỗi tệp và 25 MB tổng cho mỗi tài khoản. Bản sao lưu vault cũng chứa các tệp này." Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="Thêm tệp" Click="BtnAdd_Click" Style="{StaticResource OutlineButton}" Padding="14,7" />
            <Button DockPanel.Dock="Left" Content="Xóa tệp đã chọn" Click="BtnRemove_Click" Style="{StaticResource OutlineButton}" Padding="14,7" Margin="8,0,0,0" />
            <TextBlock x:Name="lblSize" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
        <DataGrid x:Name="dgAttachments" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên tệp" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="Kích thước" Binding="{Binding SizeText}" Width="120" />
                <DataGridTextColumn Header="Ngày thêm" Binding="{Binding AddedAtText}" Width="170" />
                <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Xuất tệp" Tag="{Binding Id}" Click="BtnExport_Click" Style="{StaticResource RowButton}" Padding="8,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Lưu" Click="BtnSave_Click" IsDefault="True" Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
