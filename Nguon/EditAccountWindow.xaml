<Window x:Class="PersonalInfoManager.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tài khoản"
        Height="650" Width="550"
        MinHeight="580" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0"
                       x:Name="lblTitle"
                       Text="🔐 Thêm tài khoản mới"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1"
                       Text="Điền thông tin tài khoản cần lưu"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />

            <!-- Tên dịch vụ -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Tên dịch vụ / website (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtService"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Username -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="Username / Email (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="4" Margin="0,15,0,0">
                <TextBlock Text="Password (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 x:Name="txtPassword"
                                 Height="44"
                                 FontSize="14"
                                 Padding="12,10"
                                 VerticalContentAlignment="Center" />

                    <TextBox Grid.Column="0"
                             x:Name="txtPasswordVisible"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed" />

                    <Button Grid.Column="1"
                            x:Name="btnTogglePwd"
                            Height="44"
                            Width="52"
                            Margin="8,0,0,0"
                            Click="BtnTogglePwd_Click">
                        <TextBlock Text="👁"
                                   FontSize="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Ghi chú -->
            <StackPanel Grid.Row="5" Margin="0,15,0,0">
                <TextBlock Text="Ghi chú:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtNote"
                         Height="90"
                         FontSize="14"
                         Padding="12,10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </StackPanel>

            <!-- Tạo MK mạnh -->
            <StackPanel Grid.Row="6" Orientation="Horizontal"
                        Margin="0,15,0,0">
                <Button Height="40" Padding="15,8"
                        Click="BtnGeneratePwd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲" FontSize="14"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Tạo MK mạnh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="lblPwdStrength"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontStyle="Italic"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Nút hành động -->
            <Grid Grid.Row="7" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="Hủy"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        Click="BtnSave_Click">
                    <TextBlock Text="✓ Lưu"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>