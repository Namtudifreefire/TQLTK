<Window x:Class="PersonalInfoManager.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.editaccountwindow.text001}"
        Height="820" Width="620"
        MinHeight="650" MinWidth="540"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}"
        Closing="EditAccountWindow_Closing" Closed="EditAccountWindow_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       x:Name="lblTitle"
                       Text="{DynamicResource xaml.editaccountwindow.text002}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <TextBlock Grid.Row="1"
                       Text="{DynamicResource xaml.editaccountwindow.text003}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text004}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtService"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center"
                         TextChanged="FormField_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text005}"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="txtWebsiteUrl" Height="40" Padding="10"
                         VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource xaml.editaccountwindow.text006}"
                         TextChanged="FormField_TextChanged" />
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{DynamicResource xaml.editaccountwindow.text007}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="txtFolder" Height="38" Padding="9" VerticalContentAlignment="Center"
                             TextChanged="FormField_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="{DynamicResource xaml.editaccountwindow.text008}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="txtTags" Height="38" Padding="9" VerticalContentAlignment="Center"
                             TextChanged="FormField_TextChanged" />
                </StackPanel>
                <CheckBox x:Name="chkFavorite" Grid.Row="1" Grid.ColumnSpan="3" Content="{DynamicResource xaml.editaccountwindow.text009}"
                          Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Checked="FormField_CheckedChanged" Unchecked="FormField_CheckedChanged" />
            </Grid>
            <StackPanel Grid.Row="5" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text010}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center"
                         TextChanged="FormField_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text011}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox Grid.Column="0"
                                 x:Name="txtPassword"
                                 Height="44"
                                 FontSize="14"
                                 Padding="12,10"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="TxtPassword_PasswordChanged" />
                    <TextBox Grid.Column="0"
                             x:Name="txtPasswordVisible"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtPasswordVisible_TextChanged"
                             Visibility="Collapsed" />
                    <Button Grid.Column="1"
                            x:Name="btnTogglePwd"
                            Height="44"
                            Width="52"
                            Margin="8,0,0,0"
                            Click="BtnTogglePwd_Click">
                        <TextBlock Text="👁"
                                   FontSize="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="7" Margin="0,15,0,0">
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="btnDeleteNote" Content="{DynamicResource xaml.editaccountwindow.text012}"
                            Padding="9,4" Style="{StaticResource OutlineButton}"
                            Click="BtnDeleteNote_Click" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource xaml.editaccountwindow.text013}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="txtNote"
                         Height="90"
                         FontSize="14"
                         Padding="12,10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         TextChanged="TxtNote_TextChanged"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </StackPanel>
            <StackPanel Grid.Row="8" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text014}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="{DynamicResource xaml.editaccountwindow.text015}" Padding="14,7" Click="BtnManageTotp_Click" />
                    <Button x:Name="btnRemoveTotp" Content="{DynamicResource xaml.editaccountwindow.text016}" Padding="14,7" Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}" Click="BtnRemoveTotp_Click" Visibility="Collapsed" />
                </WrapPanel>
                <TextBlock x:Name="lblTotpStatus" Text="{DynamicResource xaml.editaccountwindow.text017}"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="9" Margin="0,15,0,0">
                <TextBlock Text="{DynamicResource xaml.editaccountwindow.text018}" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="{DynamicResource xaml.editaccountwindow.text019}" Padding="14,7" Click="BtnManageCustomFields_Click" />
                    <TextBlock x:Name="lblCustomFieldsStatus" Text="{DynamicResource xaml.editaccountwindow.text020}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,15,0,0">
                <Button Height="40" Padding="15,8" Click="BtnGeneratePwd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.editaccountwindow.text021}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="lblPwdStrength" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Row="11" Margin="0,16,0,0" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="chkEncryptedDraft" Content="{DynamicResource xaml.editaccountwindow.text022}"
                              Checked="ChkEncryptedDraft_Checked" Unchecked="ChkEncryptedDraft_Unchecked"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="lblDraftStatus" Text="{DynamicResource xaml.editaccountwindow.text023}"
                               TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
            <Grid Grid.Row="1" Margin="35,12,35,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="{DynamicResource xaml.editaccountwindow.text024}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        Click="BtnSave_Click">
                    <TextBlock Text="{DynamicResource xaml.editaccountwindow.text025}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>
    </Grid>
</Window>
