<Window x:Class="PersonalInfoManager.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tài khoản"
        Height="820" Width="620"
        MinHeight="650" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="lblTitle"
                       Text="🔐 Thêm tài khoản mới"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1"
                       Text="Điền thông tin tài khoản cần lưu"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />

            <StackPanel Grid.Row="2">
                <TextBlock Text="Tên dịch vụ / website (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtService"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="URL chính thức của website:"
                           FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="txtWebsiteUrl" Height="40" Padding="10"
                         VerticalContentAlignment="Center"
                         ToolTip="Nhập URL http:// hoặc https:// chính thức. Chỉ so khớp chính xác hostname." />
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Thư mục" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="txtFolder" Height="38" Padding="9" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Nhãn (phân cách bằng dấu phẩy)" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="txtTags" Height="38" Padding="9" VerticalContentAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="chkFavorite" Grid.Row="1" Grid.ColumnSpan="3" Content="Đánh dấu yêu thích"
                          Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="5" Margin="0,15,0,0">
                <TextBlock Text="Tên đăng nhập / Email (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="txtUsername"
                         Height="44"
                         FontSize="14"
                         Padding="12,10"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,15,0,0">
                <TextBlock Text="Mật khẩu (*):"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 x:Name="txtPassword"
                                 Height="44"
                                 FontSize="14"
                                 Padding="12,10"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="TxtPassword_PasswordChanged" />

                    <TextBox Grid.Column="0"
                             x:Name="txtPasswordVisible"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtPasswordVisible_TextChanged"
                             Visibility="Collapsed" />

                    <Button Grid.Column="1"
                            x:Name="btnTogglePwd"
                            Height="44"
                            Width="52"
                            Margin="8,0,0,0"
                            Click="BtnTogglePwd_Click">
                        <TextBlock Text="👁"
                                   FontSize="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="7" Margin="0,15,0,0">
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" x:Name="btnDeleteNote" Content="Đưa ghi chú vào thùng rác"
                            Padding="9,4" Style="{StaticResource OutlineButton}"
                            Click="BtnDeleteNote_Click" Visibility="Collapsed" />
                    <TextBlock Text="Ghi chú:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="txtNote"
                         Height="90"
                         FontSize="14"
                         Padding="12,10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         TextChanged="TxtNote_TextChanged"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </StackPanel>

            <StackPanel Grid.Row="8" Margin="0,15,0,0">
                <TextBlock Text="Mã xác thực cho website (TOTP)" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="Nhập / đổi TOTP" Padding="14,7" Click="BtnManageTotp_Click" />
                    <Button x:Name="btnRemoveTotp" Content="Xóa TOTP" Padding="14,7" Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}" Click="BtnRemoveTotp_Click" Visibility="Collapsed" />
                </WrapPanel>
                <TextBlock x:Name="lblTotpStatus" Text="Chưa có mã xác thực cho website này."
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="9" Margin="0,15,0,0">
                <TextBlock Text="Trường tùy chỉnh" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <WrapPanel>
                    <Button Content="Quản lý trường…" Padding="14,7" Click="BtnManageCustomFields_Click" />
                    <TextBlock x:Name="lblCustomFieldsStatus" Text="Chưa có trường tùy chỉnh"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,15,0,0">
                <Button Height="40" Padding="15,8" Click="BtnGeneratePwd_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tạo / tùy chỉnh mật khẩu" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="lblPwdStrength" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="11" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="Hủy"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        Click="BtnSave_Click">
                    <TextBlock Text="✓ Lưu"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
