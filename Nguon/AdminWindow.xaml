<Window x:Class="PersonalInfoManager.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.adminwindow.text001}"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource xaml.adminwindow.text002}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{DynamicResource xaml.adminwindow.text003}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="txtNewUser"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{DynamicResource xaml.adminwindow.text004}"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <PasswordBox Grid.Row="0" Grid.Column="3"
                                 x:Name="txtNewPwd"
                                 Height="38"
                                 Margin="0,4"
                                 VerticalContentAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Text="{DynamicResource xaml.adminwindow.text005}"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox Grid.Row="0" Grid.Column="5"
                              x:Name="cbRole"
                              Height="38"
                              Margin="0,4"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="{DynamicResource xaml.adminwindow.text006}" />
                        <ComboBoxItem Content="{DynamicResource xaml.adminwindow.text007}" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{DynamicResource xaml.adminwindow.text008}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="txtNewFullName"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{DynamicResource xaml.adminwindow.text009}"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="3"
                             x:Name="txtNewEmail"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="4"
                               Text="{DynamicResource xaml.adminwindow.text010}"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="5"
                             x:Name="txtNewPhone"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />
                </Grid>
                <Button Content="{DynamicResource xaml.adminwindow.text011}"
                        Width="180"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="BtnCreate_Click" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,12">
            <DataGrid x:Name="dgUsers"
                      Style="{StaticResource FadeInDataGrid}"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text012}"
                                        Binding="{Binding Username}"
                                        Width="Auto" MinWidth="140" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text013}"
                                        Binding="{Binding FullName}"
                                        Width="Auto" MinWidth="180" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text014}"
                                        Binding="{Binding Email}"
                                        Width="Auto" MinWidth="220" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text015}"
                                        Binding="{Binding Phone}"
                                        Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text016}"
                                        Binding="{Binding Role, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=Role}"
                                        Width="Auto" MinWidth="100" />
                    <DataGridCheckBoxColumn Header="{DynamicResource xaml.adminwindow.text017}"
                                            Binding="{Binding IsActive}"
                                            Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text018}"
                                        Binding="{Binding CreatedAt, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=DateTime}"
                                        Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text019}"
                                        Binding="{Binding LastLoginAt, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=LastLoginAt}"
                                        Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="{DynamicResource xaml.adminwindow.text020}"
                                        Binding="{Binding Id}"
                                        Width="Auto" MinWidth="280" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Button Height="40" Margin="3" Click="BtnEdit_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text021}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Click="BtnResetPwd_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔑" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text022}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Click="BtnToggleActive_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text023}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Click="BtnToggleRole_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text024}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Background="#EF4444"
                        Foreground="White" BorderThickness="0"
                        Click="BtnDelete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text025}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Click="BtnRefresh_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text026}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Height="40" Margin="3" Click="BtnViewLog_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource xaml.adminwindow.text027}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
