<Window x:Class="PersonalInfoManager.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý tài khoản - TQLTK"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ============ FORM TẠO TÀI KHOẢN MỚI ======================== -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="➕ Tạo tài khoản mới"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Tên ĐN:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="txtNewUser"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Mật khẩu:"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <PasswordBox Grid.Row="0" Grid.Column="3"
                                 x:Name="txtNewPwd"
                                 Height="38"
                                 Margin="0,4"
                                 VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Text="Vai trò:"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox Grid.Row="0" Grid.Column="5"
                              x:Name="cbRole"
                              Height="38"
                              Margin="0,4"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="User" />
                        <ComboBoxItem Content="Admin" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Họ tên:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="txtNewFullName"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Gmail:"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="3"
                             x:Name="txtNewEmail"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="4"
                               Text="SĐT:"
                               VerticalAlignment="Center"
                               Margin="15,0,6,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Grid.Row="1" Grid.Column="5"
                             x:Name="txtNewPhone"
                             Height="38"
                             Margin="0,4"
                             VerticalContentAlignment="Center" />
                </Grid>

                <Button Content="➕ Tạo tài khoản"
                        Width="180"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="BtnCreate_Click" />
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- ============ BẢNG DANH SÁCH USER =========================== -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,12">
            <DataGrid x:Name="dgUsers"
                      Style="{StaticResource FadeInDataGrid}"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên đăng nhập"
                                        Binding="{Binding Username}"
                                        Width="Auto" MinWidth="140" />
                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding FullName}"
                                        Width="Auto" MinWidth="180" />
                    <DataGridTextColumn Header="Gmail"
                                        Binding="{Binding Email}"
                                        Width="Auto" MinWidth="220" />
                    <DataGridTextColumn Header="SĐT"
                                        Binding="{Binding Phone}"
                                        Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Vai trò"
                                        Binding="{Binding Role}"
                                        Width="Auto" MinWidth="100" />
                    <DataGridCheckBoxColumn Header="HĐ"
                                            Binding="{Binding IsActive}"
                                            Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="Tạo lúc"
                                        Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"
                                        Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="ĐN cuối"
                                        Binding="{Binding LastLoginAt, StringFormat='dd/MM/yyyy HH:mm', TargetNullValue='(chưa)'}"
                                        Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding Id}"
                                        Width="Auto" MinWidth="280" />
                    <DataGridTextColumn Header="PasswordHash"
                                        Binding="{Binding PasswordHash}"
                                        Width="Auto" MinWidth="300" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================ -->
        <!-- ============ THANH HÀNH ĐỘNG ============================== -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <WrapPanel Orientation="Horizontal">
                <Button Height="40" Margin="3" Click="BtnEdit_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sửa" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Click="BtnResetPwd_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔑" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reset MK" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Click="BtnToggleActive_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Khóa / Mở" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Click="BtnToggleRole_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cấp / Thu Admin" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Background="#EF4444"
                        Foreground="White" BorderThickness="0"
                        Click="BtnDelete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Xóa" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Click="BtnRefresh_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Height="40" Margin="3" Click="BtnViewLog_Click"
                        Style="{StaticResource OutlineButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Xem Log" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>