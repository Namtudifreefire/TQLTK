<Window x:Class="PersonalInfoManager.DriveSharesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liên kết Drive đang chia sẻ" Height="520" Width="850" MinHeight="420" MinWidth="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Liên kết Drive đang chia sẻ" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Thu hồi quyền Drive và chuyển gói vào thùng rác. Không thể thu hồi dữ liệu đã tải hoặc giải mã." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <DataGrid x:Name="dgShares" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Email người nhận" Binding="{Binding RecipientEmail}" Width="*" />
                <DataGridTextColumn Header="Hết hạn" Binding="{Binding ExpiresText}" Width="190" />
                <DataGridTextColumn Header="Tạo lúc" Binding="{Binding CreatedText}" Width="190" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Đóng" Click="BtnClose_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Thu hồi quyền" Click="BtnRevoke_Click" Background="#EF4444" Foreground="White" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
