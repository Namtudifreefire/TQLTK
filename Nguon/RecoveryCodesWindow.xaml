<Window x:Class="PersonalInfoManager.RecoveryCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.recoverycodeswindow.text001}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource xaml.recoverycodeswindow.text002}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock TextWrapping="Wrap"
                   Margin="0,8,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{DynamicResource xaml.recoverycodeswindow.text003}" />
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <ScrollViewer Height="160" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtCodes"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="17"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="lblError"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Foreground="#EF4444" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{DynamicResource xaml.recoverycodeswindow.text004}"
                    Padding="15,8"
                    Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnCopy_Click" />
            <Button Content="{DynamicResource xaml.recoverycodeswindow.text005}"
                    Padding="15,8"
                    Click="BtnFinish_Click" />
        </StackPanel>
    </StackPanel>
</Window>
