<Window x:Class="PersonalInfoManager.TotpCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mã xác thực TOTP" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Closed="Window_Closed">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="lblAccount" Text="Website" FontSize="17" FontWeight="SemiBold"
                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1" x:Name="lblCode" Text="------" FontSize="38" FontWeight="Bold"
                   FontFamily="Consolas" TextAlignment="Center" Margin="0,15,0,4"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock x:Name="lblCountdown" Text="" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ProgressBar x:Name="barLifetime" Height="7" Margin="0,8,0,0" />
        </StackPanel>
        <Button Grid.Row="3" Content="Copy mã (clipboard tự xóa)" Click="BtnCopy_Click" Padding="16,9" />
    </Grid>
</Window>
