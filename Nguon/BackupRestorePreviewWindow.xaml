<Window x:Class="PersonalInfoManager.BackupRestorePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước khôi phục"
        Height="560" Width="820"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="Xem trước khôi phục"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="txtSummary" Grid.Row="1" Margin="0,8,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="dgItems" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mục" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Kết quả dự kiến" Binding="{Binding Status, Converter={StaticResource LocalizedTextConverter}}" Width="150" />
                    <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=BackupDetails}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <CheckBox x:Name="chkRestoreSettings" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Áp dụng các cài đặt an toàn có trong bản sao lưu (ngôn ngữ, giao diện và thời gian khóa)."
                       TextWrapping="Wrap" />
        </CheckBox>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" MinWidth="90" IsCancel="True" Style="{StaticResource OutlineButton}" />
            <Button Content="Tiếp tục khôi phục" MinWidth="160" Margin="8,0,0,0"
                    IsDefault="True" Click="BtnContinue_Click" />
        </WrapPanel>
    </Grid>
</Window>
