<Window x:Class="PersonalInfoManager.BackupRestorePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.backuprestorepreviewwindow.text001}"
        Height="560" Width="820"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="{DynamicResource xaml.backuprestorepreviewwindow.text001}"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="txtSummary" Grid.Row="1" Margin="0,8,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="dgItems" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" BorderThickness="0"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource xaml.backuprestorepreviewwindow.text002}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{DynamicResource xaml.backuprestorepreviewwindow.text003}" Binding="{Binding Status, Converter={StaticResource LocalizedTextConverter}}" Width="150" />
                    <DataGridTextColumn Header="{DynamicResource xaml.backuprestorepreviewwindow.text004}" Binding="{Binding Details, Converter={StaticResource LocalizedTextConverter}, ConverterParameter=BackupDetails}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <CheckBox x:Name="chkRestoreSettings" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource xaml.backuprestorepreviewwindow.text005}"
                       TextWrapping="Wrap" />
        </CheckBox>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource xaml.backuprestorepreviewwindow.text006}" MinWidth="90" IsCancel="True" Style="{StaticResource OutlineButton}" />
            <Button Content="{DynamicResource xaml.backuprestorepreviewwindow.text007}" MinWidth="160" Margin="8,0,0,0"
                    IsDefault="True" Click="BtnContinue_Click" />
        </WrapPanel>
    </Grid>
</Window>
