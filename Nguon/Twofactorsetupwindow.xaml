<Window x:Class="PersonalInfoManager.TwoFactorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bật xác thực 2 bước (Authenticator)"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="24">

        <!-- ================== BƯỚC 1: QUÉT QR + XÁC NHẬN ================== -->
        <StackPanel x:Name="pnlStep1">

            <TextBlock Text="🔑 Bật xác thực 2 bước"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12" />

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12">
                <Run Text="1. Cài Google Authenticator, Microsoft Authenticator hoặc Authy trên điện thoại." />
                <LineBreak />
                <Run Text="2. Chọn Thêm tài khoản → Quét mã QR, rồi quét mã bên dưới." />
                <LineBreak />
                <Run Text="3. Nhập mã 6 số đang hiển thị trong ứng dụng để xác nhận." />
            </TextBlock>

            <Border Background="White" CornerRadius="8" Padding="10"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <Image x:Name="imgQr" Width="200" Height="200"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <TextBlock Text="Không quét được? Nhập khóa này thủ công vào ứng dụng:"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSecret"
                         Grid.Column="0"
                         Height="34"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center" />

                <Button Grid.Column="1"
                        Content="📋 Copy"
                        Height="34" Padding="12,4" Margin="6,0,0,0"
                        Style="{StaticResource OutlineButton}"
                        Click="BtnCopySecret_Click" />
            </Grid>

            <TextBlock Text="Mã 6 số trong ứng dụng:"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,5" />

            <TextBox x:Name="txtCode"
                     Height="44"
                     FontSize="20"
                     MaxLength="7"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center" />

            <TextBlock x:Name="lblError"
                       Foreground="#EF4444"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Hủy"
                        Height="38" Padding="20,8" Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource OutlineButton}" />
                <Button Content="Xác nhận và bật"
                        Height="38" Padding="20,8"
                        IsDefault="True"
                        Click="BtnConfirm_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ================== BƯỚC 2: MÃ KHÔI PHỤC ================== -->
        <StackPanel x:Name="pnlStep2" Visibility="Collapsed">

            <TextBlock Text="✅ Đã bật xác thực 2 bước"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12" />

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12">
                <Run Text="Đây là 8 mã khôi phục, mỗi mã dùng được 1 lần khi bạn mất điện thoại." />
                <LineBreak />
                <Run Text="Hãy lưu ở nơi an toàn (giấy, két sắt...). Mã chỉ hiển thị MỘT LẦN duy nhất." FontWeight="SemiBold" />
            </TextBlock>

            <TextBox x:Name="txtRecovery"
                     Height="200"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="16"
                     Padding="10"
                     HorizontalContentAlignment="Center"
                     VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="📋 Copy mã"
                        Height="38" Padding="20,8" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}"
                        Click="BtnCopyRecovery_Click" />
                <Button Content="Tôi đã lưu, hoàn tất"
                        Height="38" Padding="20,8"
                        Click="BtnFinish_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
