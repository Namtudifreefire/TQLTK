<Window x:Class="PersonalInfoManager.TwoFactorSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.twofactorsetupwindow.text001}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <StackPanel x:Name="pnlStep1">
            <TextBlock Text="{DynamicResource xaml.twofactorsetupwindow.text002}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12">
                <Run Text="{DynamicResource xaml.twofactorsetupwindow.text003}" />
                <LineBreak />
                <Run Text="{DynamicResource xaml.twofactorsetupwindow.text004}" />
                <LineBreak />
                <Run Text="{DynamicResource xaml.twofactorsetupwindow.text005}" />
            </TextBlock>
            <Border Background="White" CornerRadius="8" Padding="10"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <Image x:Name="imgQr" Width="200" Height="200"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock Text="{DynamicResource xaml.twofactorsetupwindow.text006}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Height="34"
                        Padding="8,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtSecret"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
                <Button Grid.Column="1"
                        Content="{DynamicResource xaml.twofactorsetupwindow.text007}"
                        Height="34" Padding="12,4" Margin="6,0,0,0"
                        Style="{StaticResource OutlineButton}"
                        Click="BtnCopySecret_Click" />
            </Grid>
            <TextBlock Text="{DynamicResource xaml.twofactorsetupwindow.text008}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,5" />
            <TextBox x:Name="txtCode"
                     Height="44"
                     FontSize="20"
                     MaxLength="7"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center" />
            <TextBlock x:Name="lblError"
                       Foreground="#EF4444"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource xaml.twofactorsetupwindow.text009}"
                        Height="38" Padding="20,8" Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource OutlineButton}" />
                <Button Content="{DynamicResource xaml.twofactorsetupwindow.text010}"
                        Height="38" Padding="20,8"
                        IsDefault="True"
                        Click="BtnConfirm_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="pnlStep2" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource xaml.twofactorsetupwindow.text011}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12">
                <Run Text="{DynamicResource xaml.twofactorsetupwindow.text012}" />
                <LineBreak />
                <Run Text="{DynamicResource xaml.twofactorsetupwindow.text013}" FontWeight="SemiBold" />
            </TextBlock>
            <Border Height="200"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtRecovery"
                               FontFamily="Consolas"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource xaml.twofactorsetupwindow.text014}"
                        Height="38" Padding="20,8" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}"
                        Click="BtnCopyRecovery_Click" />
                <Button Content="{DynamicResource xaml.twofactorsetupwindow.text015}"
                        Height="38" Padding="20,8"
                        Click="BtnFinish_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
