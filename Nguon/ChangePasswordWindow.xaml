<Window x:Class="PersonalInfoManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.changepasswordwindow.text001}"
        Height="560" Width="500"
        MinHeight="500" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource xaml.changepasswordwindow.text002}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />
            <StackPanel Grid.Row="1" Margin="0,0,0,25">
                <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text003}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text004}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text005}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtOldPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text006}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtNewPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtNewPwd_PasswordChanged" />
                <TextBlock x:Name="lblStrength"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text007}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtConfirmPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtConfirmPwd_PasswordChanged" />
                <TextBlock x:Name="lblConfirm"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="5"
                       x:Name="lblStatus"
                       Foreground="#EF4444"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,15,0,0" />
            <Grid Grid.Row="6" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text008}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        IsDefault="True"
                        Click="BtnOk_Click">
                    <TextBlock Text="{DynamicResource xaml.changepasswordwindow.text009}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="7"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap">
                Mật khẩu mới: tối thiểu 8 ký tự nếu bật 2FA, nếu không tối thiểu 15 ký tự
            </TextBlock>
        </Grid>
    </ScrollViewer>
</Window>
