<Window x:Class="PersonalInfoManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu - TQLTK"
        Height="560" Width="500"
        MinHeight="500" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Style="{StaticResource SlideInWindow}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="35,25,35,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0"
                       Text="🔐 Đổi mật khẩu"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Grid.Row="1"
                       Text="Nhập mật khẩu hiện tại và mật khẩu mới"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25" />

            <!-- Mật khẩu hiện tại -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Mật khẩu hiện tại:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtOldPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Mật khẩu mới -->
            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock Text="Mật khẩu mới:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtNewPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtNewPwd_PasswordChanged" />
                <TextBlock x:Name="lblStrength"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Xác nhận mật khẩu -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="Xác nhận mật khẩu mới:"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="txtConfirmPwd"
                             Height="44"
                             FontSize="14"
                             Padding="12,10"
                             VerticalContentAlignment="Center"
                             PasswordChanged="TxtConfirmPwd_PasswordChanged" />
                <TextBlock x:Name="lblConfirm"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Trạng thái -->
            <TextBlock Grid.Row="5"
                       x:Name="lblStatus"
                       Foreground="#EF4444"
                       FontSize="12"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,15,0,0" />

            <!-- Nút hành động -->
            <Grid Grid.Row="6" Margin="0,25,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="46"
                        Margin="0,0,6,0"
                        Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButton}">
                    <TextBlock Text="Hủy"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>

                <Button Grid.Column="1"
                        Height="46"
                        Margin="6,0,0,0"
                        IsDefault="True"
                        Click="BtnOk_Click">
                    <TextBlock Text="✓ Xác nhận"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Gợi ý -->
            <TextBlock Grid.Row="7"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,15,0,0"
                       TextWrapping="Wrap">
                Mật khẩu mới phải từ 6 ký tự trở lên
            </TextBlock>

        </Grid>
    </ScrollViewer>
</Window>