<Window x:Class="PersonalInfoManager.AccountShareSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chia sẻ tạm thời" Height="430" Width="610" MinHeight="390" MinWidth="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Chia sẻ tài khoản có thời hạn" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="Drive chỉ cấp quyền đọc cho địa chỉ email này. Một khóa ngẫu nhiên sẽ mã hóa gói; hãy gửi khóa qua kênh riêng." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="Email người nhận" Margin="0,0,0,6" />
            <TextBox x:Name="txtEmail" Height="38" VerticalContentAlignment="Center" />
            <TextBlock Text="Tự hết hạn sau" Margin="0,15,0,6" />
            <ComboBox x:Name="cmbDays" Height="38" SelectedIndex="1" VerticalContentAlignment="Center">
                <ComboBoxItem Content="1 ngày" Tag="1" /><ComboBoxItem Content="7 ngày" Tag="7" /><ComboBoxItem Content="30 ngày" Tag="30" />
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Khi hết hạn hoặc bị thu hồi, quyền tải file từ Drive sẽ bị hủy. Người nhận có thể giữ bản sao đã tải hoặc dữ liệu đã giải mã." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,16,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Tạo liên kết" Click="BtnCreate_Click" IsDefault="True" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
