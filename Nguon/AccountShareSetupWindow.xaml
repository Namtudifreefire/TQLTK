<Window x:Class="PersonalInfoManager.AccountShareSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.accountsharesetupwindow.text001}" Height="430" Width="610" MinHeight="390" MinWidth="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource xaml.accountsharesetupwindow.text002}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{DynamicResource xaml.accountsharesetupwindow.text003}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource xaml.accountsharesetupwindow.text004}" Margin="0,0,0,6" />
            <TextBox x:Name="txtEmail" Height="38" VerticalContentAlignment="Center" />
            <TextBlock Text="{DynamicResource xaml.accountsharesetupwindow.text005}" Margin="0,15,0,6" />
            <ComboBox x:Name="cmbDays" Height="38" SelectedIndex="1" VerticalContentAlignment="Center">
                <ComboBoxItem Content="{DynamicResource xaml.accountsharesetupwindow.text006}" Tag="1" /><ComboBoxItem Content="{DynamicResource xaml.accountsharesetupwindow.text007}" Tag="7" /><ComboBoxItem Content="{DynamicResource xaml.accountsharesetupwindow.text008}" Tag="30" />
            </ComboBox>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{DynamicResource xaml.accountsharesetupwindow.text009}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,16,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource xaml.accountsharesetupwindow.text010}" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="{DynamicResource xaml.accountsharesetupwindow.text011}" Click="BtnCreate_Click" IsDefault="True" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
