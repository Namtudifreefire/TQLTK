<Window x:Class="PersonalInfoManager.BulkAccountActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.bulkaccountactionswindow.text001}" Height="470" Width="620" MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource xaml.bulkaccountactionswindow.text001}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="lblSelectedCount" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <CheckBox x:Name="chkApplyFolder" Grid.Row="1" Content="{DynamicResource xaml.bulkaccountactionswindow.text002}" Margin="0,6" />
        <TextBox x:Name="txtFolder" Grid.Row="2" Height="38" VerticalContentAlignment="Center" IsEnabled="False" />
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="chkApplyTags" Content="{DynamicResource xaml.bulkaccountactionswindow.text003}" Margin="0,6" />
            <TextBox x:Name="txtTags" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsEnabled="False" />
            <CheckBox x:Name="chkMoveToTrash" Content="{DynamicResource xaml.bulkaccountactionswindow.text004}" Margin="0,14,0,0" Foreground="#EF4444" />
            <TextBlock Text="{DynamicResource xaml.bulkaccountactionswindow.text005}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource xaml.bulkaccountactionswindow.text006}" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="{DynamicResource xaml.bulkaccountactionswindow.text007}" Click="BtnApply_Click" IsDefault="True" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
