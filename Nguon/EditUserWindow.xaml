<Window x:Class="PersonalInfoManager.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.edituserwindow.text001}"
        Width="450"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height, FallbackValue=600}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource xaml.edituserwindow.text002}"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />
            <StackPanel Grid.Row="1">
                <TextBlock Text="{DynamicResource xaml.edituserwindow.text003}" />
                <TextBox x:Name="txtUsername" Height="30"
                         IsReadOnly="True" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource xaml.edituserwindow.text004}" />
                <TextBox x:Name="txtFullName" Height="30" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource xaml.edituserwindow.text005}" />
                <TextBox x:Name="txtEmail" Height="30" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource xaml.edituserwindow.text006}" />
                <TextBox x:Name="txtPhone" Height="30" />
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource xaml.edituserwindow.text007}" Width="90" Height="32"
                        Click="BtnCancel_Click" />
                <Button Content="{DynamicResource xaml.edituserwindow.text008}" Width="110" Height="32"
                        Click="BtnSave_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
