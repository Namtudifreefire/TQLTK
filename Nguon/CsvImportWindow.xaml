<Window x:Class="PersonalInfoManager.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import tài khoản từ CSV"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📥 Import tài khoản từ CSV"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />
            <TextBlock x:Name="lblInfo"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Thống kê -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblTotal" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,20,0" />
                <TextBlock x:Name="lblDuplicates" FontSize="13" FontWeight="SemiBold"
                           Foreground="#EF4444"
                           Margin="0,0,20,0" />
                <TextBlock x:Name="lblWillImport" FontSize="13" FontWeight="SemiBold"
                           Foreground="#22C55E" />
            </StackPanel>
        </Border>

        <!-- DataGrid preview -->
        <DataGrid Grid.Row="2"
                  x:Name="dgPreview"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="40" />
                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding ServiceName}" Width="180" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                <DataGridTextColumn Header="Password" Binding="{Binding MaskedPassword}" Width="120" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nút hành động -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Chọn tất cả"
                    Click="BtnSelectAll_Click"
                    Padding="16,8" Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="Bỏ chọn tất cả"
                    Click="BtnDeselectAll_Click"
                    Padding="16,8" Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="Hủy"
                    Click="BtnCancel_Click"
                    Padding="16,8" Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="📥 Import"
                    Click="BtnImport_Click"
                    Padding="20,8"
                    IsDefault="True"
                    Background="#22C55E"
                    Foreground="White"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>