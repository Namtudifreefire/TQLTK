<Window x:Class="PersonalInfoManager.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.csvimportwindow.text001}" Height="620" Width="1050" MinHeight="450" MinWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.csvimportwindow.text002}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
            <TextBlock x:Name="lblInfo" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock x:Name="lblTotal" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,20,0" />
                <TextBlock x:Name="lblDuplicates" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,20,0" />
                <TextBlock x:Name="lblWillImport" FontSize="13" FontWeight="SemiBold" Foreground="#22C55E" Margin="0,0,20,0" />
                <TextBlock x:Name="lblWillOverwrite" FontSize="13" FontWeight="SemiBold" Foreground="#F59E0B" />
            </WrapPanel>
        </Border>
        <DataGrid Grid.Row="2" x:Name="dgPreview" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource xaml.csvimportwindow.text003}" Binding="{Binding ServiceName}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{DynamicResource xaml.csvimportwindow.text004}" Binding="{Binding Username}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{DynamicResource xaml.csvimportwindow.text005}" Binding="{Binding MaskedPassword}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="{DynamicResource xaml.csvimportwindow.text006}" Binding="{Binding Note}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="{DynamicResource xaml.csvimportwindow.text007}" Binding="{Binding TargetDescription}" Width="190" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{DynamicResource xaml.csvimportwindow.text008}" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ActionOptions}" SelectedValuePath="Action" DisplayMemberPath="Label" SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{DynamicResource xaml.csvimportwindow.text009}" Click="BtnSelectNew_Click" Style="{StaticResource OutlineButton}" Padding="12,7" Margin="0,0,8,0" />
                <Button Content="{DynamicResource xaml.csvimportwindow.text010}" Click="BtnSkipDuplicates_Click" Style="{StaticResource OutlineButton}" Padding="12,7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource xaml.csvimportwindow.text011}" Click="BtnCancel_Click" Style="{StaticResource OutlineButton}" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="{DynamicResource xaml.csvimportwindow.text012}" Click="BtnImport_Click" Padding="20,8" IsDefault="True" Background="#22C55E" Foreground="White" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
