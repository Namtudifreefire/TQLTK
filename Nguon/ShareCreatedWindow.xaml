<Window x:Class="PersonalInfoManager.ShareCreatedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.sharecreatedwindow.text001}" Height="520" Width="720" MinHeight="440" MinWidth="600"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource xaml.sharecreatedwindow.text002}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" x:Name="lblInfo" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
        <TextBlock Grid.Row="2" Text="{DynamicResource xaml.sharecreatedwindow.text003}" Margin="0,0,0,6" />
        <DockPanel Grid.Row="3" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Content="{DynamicResource xaml.sharecreatedwindow.text004}" Click="BtnCopyLink_Click" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="8,0,0,0" />
            <TextBox x:Name="txtLink" Height="38" VerticalContentAlignment="Center" IsReadOnly="True" />
        </DockPanel>
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{DynamicResource xaml.sharecreatedwindow.text005}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource xaml.sharecreatedwindow.text006}" Click="BtnCopyKey_Click" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="8,0,0,0" />
                    <TextBox x:Name="txtKey" Height="40" VerticalContentAlignment="Center" IsReadOnly="True" FontFamily="Consolas" FontSize="15" />
                </DockPanel>
                <TextBlock Text="{DynamicResource xaml.sharecreatedwindow.text007}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource xaml.sharecreatedwindow.text008}" Click="BtnClose_Click" IsDefault="True" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
