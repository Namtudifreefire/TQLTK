<Window x:Class="PersonalInfoManager.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo mật khẩu" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tùy chỉnh bộ tạo mật khẩu" FontSize="21" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Kiểu mật khẩu" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <ComboBox x:Name="cmbMode" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged">
                <ComboBoxItem Content="Ngẫu nhiên" />
                <ComboBoxItem Content="Cụm từ dễ nhớ" />
            </ComboBox>
        </StackPanel>

        <StackPanel x:Name="pnlRandom" Grid.Row="2" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Độ dài (8–64)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="txtLength" Text="16" Width="80" Margin="12,0,0,0" HorizontalContentAlignment="Center" />
            </DockPanel>
            <CheckBox x:Name="chkUpper" Content="Chữ hoa" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkLower" Content="Chữ thường" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkDigits" Content="Chữ số" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkSymbols" Content="Ký hiệu" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkExcludeAmbiguous" Content="Loại ký tự dễ nhầm lẫn (O/0, I/l/1)" IsChecked="True" Margin="0,3" />
        </StackPanel>

        <StackPanel x:Name="pnlPassphrase" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="Số từ (6–12)" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="txtWordCount" Text="8" Width="80" Margin="12,0,0,0" HorizontalContentAlignment="Center" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Dấu phân cách" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="cmbSeparator" Width="100" SelectedIndex="0" Margin="12,0,0,0">
                    <ComboBoxItem Content="-" />
                    <ComboBoxItem Content="khoảng trắng" />
                    <ComboBoxItem Content="." />
                    <ComboBoxItem Content="_" />
                </ComboBox>
            </DockPanel>
            <TextBlock Text="8 từ được chọn ngẫu nhiên bằng bộ sinh mật mã học." TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <Button Content="Tạo mật khẩu" Click="BtnGenerate_Click" HorizontalAlignment="Left" Padding="16,8" />
            <TextBox x:Name="txtPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="15"
                     Margin="0,10,0,0" Padding="10" TextWrapping="Wrap" />
            <TextBlock x:Name="lblError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" />
            <Button Content="Dùng mật khẩu này" Click="BtnUse_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
