<Window x:Class="PersonalInfoManager.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.passwordgeneratorwindow.text001}" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource xaml.passwordgeneratorwindow.text002}" FontSize="21" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource xaml.passwordgeneratorwindow.text003}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
            <ComboBox x:Name="cmbMode" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource xaml.passwordgeneratorwindow.text004}" />
                <ComboBoxItem Content="{DynamicResource xaml.passwordgeneratorwindow.text005}" />
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="pnlRandom" Grid.Row="2" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource xaml.passwordgeneratorwindow.text006}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="txtLength" Text="16" Width="80" Margin="12,0,0,0" HorizontalContentAlignment="Center" />
            </DockPanel>
            <CheckBox x:Name="chkUpper" Content="{DynamicResource xaml.passwordgeneratorwindow.text007}" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkLower" Content="{DynamicResource xaml.passwordgeneratorwindow.text008}" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkDigits" Content="{DynamicResource xaml.passwordgeneratorwindow.text009}" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkSymbols" Content="{DynamicResource xaml.passwordgeneratorwindow.text010}" IsChecked="True" Margin="0,3" />
            <CheckBox x:Name="chkExcludeAmbiguous" Content="{DynamicResource xaml.passwordgeneratorwindow.text011}" IsChecked="True" Margin="0,3" />
        </StackPanel>
        <StackPanel x:Name="pnlPassphrase" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource xaml.passwordgeneratorwindow.text012}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="txtWordCount" Text="8" Width="80" Margin="12,0,0,0" HorizontalContentAlignment="Center" />
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{DynamicResource xaml.passwordgeneratorwindow.text013}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="cmbSeparator" Width="100" SelectedIndex="0" Margin="12,0,0,0">
                    <ComboBoxItem Content="-" />
                    <ComboBoxItem Content="{DynamicResource xaml.passwordgeneratorwindow.text014}" />
                    <ComboBoxItem Content="." />
                    <ComboBoxItem Content="_" />
                </ComboBox>
            </DockPanel>
            <TextBlock Text="{DynamicResource xaml.passwordgeneratorwindow.text015}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
        </StackPanel>
        <Border x:Name="borderWebsitePolicy" Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="lblWebsitePolicyHost" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <CheckBox x:Name="chkUseWebsitePolicy" Content="{DynamicResource xaml.passwordgeneratorwindow.text016}"
                          Checked="WebsitePolicy_Changed" Unchecked="WebsitePolicy_Changed" Margin="0,0,0,8" />
                <Grid x:Name="gridWebsitePolicy">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource xaml.passwordgeneratorwindow.text017}" VerticalAlignment="Center" Margin="0,0,8,7" />
                    <TextBox x:Name="txtPolicyMinLength" Grid.Row="0" Grid.Column="1" Text="8" Margin="0,0,0,7" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource xaml.passwordgeneratorwindow.text018}" VerticalAlignment="Center" Margin="0,0,8,7" />
                    <TextBox x:Name="txtPolicyMaxLength" Grid.Row="0" Grid.Column="4" Text="64" Margin="0,0,0,7" />
                    <CheckBox x:Name="chkPolicyUpper" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="{DynamicResource xaml.passwordgeneratorwindow.text019}" Margin="0,2,0,2" />
                    <CheckBox x:Name="chkPolicyLower" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="{DynamicResource xaml.passwordgeneratorwindow.text020}" Margin="0,2,0,2" />
                    <CheckBox x:Name="chkPolicyDigits" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="{DynamicResource xaml.passwordgeneratorwindow.text021}" Margin="0,2,0,2" />
                    <CheckBox x:Name="chkPolicySymbols" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Content="{DynamicResource xaml.passwordgeneratorwindow.text022}" Margin="0,2,0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource xaml.passwordgeneratorwindow.text023}" VerticalAlignment="Center" Margin="0,6,8,0" />
                    <TextBox x:Name="txtPolicyExcludedCharacters" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="btnSaveWebsitePolicy" Content="{DynamicResource xaml.passwordgeneratorwindow.text024}" Click="BtnSaveWebsitePolicy_Click" Padding="10,6" />
                    <Button x:Name="btnClearWebsitePolicy" Content="{DynamicResource xaml.passwordgeneratorwindow.text025}" Click="BtnClearWebsitePolicy_Click"
                            Style="{StaticResource OutlineButton}" Padding="10,6" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="lblWebsitePolicyError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <Button Content="{DynamicResource xaml.passwordgeneratorwindow.text001}" Click="BtnGenerate_Click" HorizontalAlignment="Left" Padding="16,8" />
            <TextBox x:Name="txtPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="15"
                     Margin="0,10,0,0" Padding="10" TextWrapping="Wrap" />
            <TextBlock x:Name="lblError" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource xaml.passwordgeneratorwindow.text026}" IsCancel="True" Padding="18,8" Margin="0,0,8,0" Style="{StaticResource OutlineButton}" />
            <Button Content="{DynamicResource xaml.passwordgeneratorwindow.text027}" Click="BtnUse_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
