<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ MÀU NỀN ============ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E5EB" />

    <!-- ============ MÀU CHỮ ============ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />

    <!-- ============ MÀU NHẤN ============ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE" />

    <!-- ============ TAB ============ -->
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#EAF3FC" />

</ResourceDictionary>