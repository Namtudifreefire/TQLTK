<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E2E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2A3C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A4C" />


    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />


    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />


    <SolidColorBrush x:Key="TabBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush" Color="#3A3A4C" />
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#33334A" />

</ResourceDictionary>