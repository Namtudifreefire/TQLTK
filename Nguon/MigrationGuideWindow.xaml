<Window x:Class="PersonalInfoManager.MigrationGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hướng dẫn chuyển máy" Width="760" Height="700"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Hướng dẫn chuyển máy" FontSize="20" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="txtGuide" TextWrapping="Wrap" FontSize="14" LineHeight="24" />
            </ScrollViewer>
        </Border>
        <Button Grid.Row="2" Content="Đóng" MinWidth="110" Padding="18,8"
                HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"
                Style="{StaticResource OutlineButton}" />
    </Grid>
</Window>
