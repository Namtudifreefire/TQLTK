<Window x:Class="PersonalInfoManager.CustomFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trường tùy chỉnh" Width="650" Height="480" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Trường tùy chỉnh được lưu bên trong vault mã hóa. Trường nhạy cảm được che khi nhập và không dùng trong tìm kiếm."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Thêm" Click="BtnAdd_Click" Padding="12,6" />
                    <Button Content="Xóa" Click="BtnRemove_Click" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}" />
                </StackPanel>
                <ListBox x:Name="lstFields" DisplayMemberPath="Name" SelectionChanged="Fields_SelectionChanged" />
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Tên trường" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="txtName" Height="36" Padding="8" TextChanged="TxtName_TextChanged" />

                <DockPanel Margin="0,14,0,5">
                    <CheckBox x:Name="chkSensitive" Content="Thông tin nhạy cảm" IsThreeState="False"
                              Checked="Sensitive_Changed" Unchecked="Sensitive_Changed"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox x:Name="chkShowValue" Content="Hiện giá trị" IsThreeState="False"
                              Checked="ShowValue_Changed" Unchecked="ShowValue_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                </DockPanel>

                <TextBox x:Name="txtValue" MinHeight="150" MaxHeight="250" Padding="9"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="TxtValue_TextChanged" />
                <PasswordBox x:Name="pwdValue" MinHeight="36" Padding="8"
                             PasswordChanged="PwdValue_PasswordChanged" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" IsCancel="True" Padding="18,8" Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="Lưu trường" Click="BtnSave_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
