<Window x:Class="PersonalInfoManager.CustomFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource xaml.customfieldswindow.text001}" Width="650" Height="480" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource xaml.customfieldswindow.text002}"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource xaml.customfieldswindow.text003}" Click="BtnAdd_Click" Padding="12,6" />
                    <Button Content="{DynamicResource xaml.customfieldswindow.text004}" Click="BtnRemove_Click" Padding="12,6" Margin="8,0,0,0"
                            Style="{StaticResource OutlineButton}" />
                </StackPanel>
                <ListBox x:Name="lstFields" DisplayMemberPath="Name" SelectionChanged="Fields_SelectionChanged" />
            </DockPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource xaml.customfieldswindow.text005}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="txtName" Height="36" Padding="8" TextChanged="TxtName_TextChanged" />
                <DockPanel Margin="0,14,0,5">
                    <CheckBox x:Name="chkSensitive" Content="{DynamicResource xaml.customfieldswindow.text006}" IsThreeState="False"
                              Checked="Sensitive_Changed" Unchecked="Sensitive_Changed"
                              Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox x:Name="chkShowValue" Content="{DynamicResource xaml.customfieldswindow.text007}" IsThreeState="False"
                              Checked="ShowValue_Changed" Unchecked="ShowValue_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="txtValue" MinHeight="150" MaxHeight="250" Padding="9"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="TxtValue_TextChanged" />
                <PasswordBox x:Name="pwdValue" MinHeight="36" Padding="8"
                             PasswordChanged="PwdValue_PasswordChanged" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource xaml.customfieldswindow.text008}" IsCancel="True" Padding="18,8" Margin="0,0,8,0"
                    Style="{StaticResource OutlineButton}" />
            <Button Content="{DynamicResource xaml.customfieldswindow.text009}" Click="BtnSave_Click" Padding="18,8" />
        </StackPanel>
    </Grid>
</Window>
