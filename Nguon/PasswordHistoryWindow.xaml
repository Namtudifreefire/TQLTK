<Window x:Class="PersonalInfoManager.PasswordHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch sử mật khẩu"
        Height="430" Width="720"
        MinHeight="320" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Style="{StaticResource SlideInWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="Lịch sử mật khẩu"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="txtNote" Grid.Row="1" Margin="0,7,0,14"
                   Text="Các mật khẩu trước được giữ mã hóa trong kho mật khẩu. Chỉ lưu 5 mật khẩu gần nhất."
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <DataGrid x:Name="dgHistory" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      CanUserAddRows="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày đổi" Binding="{Binding ChangedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="170" />
                    <DataGridTextColumn Header="Mật khẩu trước đây" Binding="{Binding DisplayPassword}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Đóng" MinWidth="90" IsCancel="True" Style="{StaticResource OutlineButton}" />
            <Button x:Name="btnReveal" Content="Hiện mật khẩu" MinWidth="130" Margin="8,0,0,0"
                    IsEnabled="False" Style="{StaticResource OutlineButton}" Click="BtnReveal_Click" />
            <Button x:Name="btnCopy" Content="Sao chép" MinWidth="90" Margin="8,0,0,0"
                    IsEnabled="False" Style="{StaticResource OutlineButton}" Click="BtnCopy_Click" />
            <Button x:Name="btnRestore" Content="Dùng mật khẩu này" MinWidth="150" Margin="8,0,0,0"
                    IsEnabled="False" Click="BtnRestore_Click" />
        </StackPanel>
    </Grid>
</Window>
